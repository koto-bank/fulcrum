(module hello-sdl
  (import :c "some_inc.h")
  (import :c "SDL2/SDL.h")
  (import :c "SDL2/SDL_video.h")
  (import :c "stdio.h"))

(struct Mouse
  (enum Buttons
    (left 1u)
    (right (ash 1u 1u))
    (middle (ash 1u 2u)))
  (x u32 0u)
  (y u32 0u)
  (buttons u32 0u))

(if (SDL.leftMouseButtonPressed())
   (set (m.buttons (bit-or m.buttons Mouse.Buttons.left))))

