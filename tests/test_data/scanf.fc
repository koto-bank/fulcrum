(module c-scanf
  (import :c "stdio.h"))

(fn main i32 ()
  (var name (array i8 64))
  (var age i32)
  (printf "Please enter your name: ")
  (scanf "%s" (addr-of name))
  (printf "Please enter your age: ")
  (scanf "%d" (addr-of age))
  (printf "You are %s, and ten years ago you was" name)
  (if (>= (- age 10) 0)
      (printf " %d years old\n" (- age 10))
    (printf "n't around here yet\n"))
  (return 0))
