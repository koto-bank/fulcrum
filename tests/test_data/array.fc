(module array
  (import :c "stdio.h"))

(fn print-array void ((array (array str 10)) (size i32))
  (var i i32 0)
  (while (< i size)
    (printf "String at %p which is '%s'\n" (at array i) (at array i))
   (set i (+ i 1))))

(fn main i32 ((argc i32) (argv (ptr str)))
  (var str-arr (array (ptr i8) 5))
  (var i i32 0)
  (var arr-size i32 (- argc 1))
  (if (> arr-size 5)
    (progn
      (puts "More than 5 arguments passed, ignoring the rest\n")
      (set arr-size 5)))

  (while (< i arr-size)
    (set (at str-arr i) (deref (ptr+ argv (+ i 1))))
    (set i (+ i 1)))

  (puts "First, print array from main function\n")
  (set i 0)
  (while (< i arr-size)
    (printf "String at %p which is '%s'\n" (at str-arr i) (at str-arr i))
    (set i (+ i 1)))

  (puts "----------------------------------------\n")
  (puts "Now, pass array as an argument\n")
  (print-array str-arr arr-size)

  (return 0))
