(module array
  (import :c "stdio.h"))

(fn print-array void ((array (array str 10)) (size i32))
  (var i i32 0)
  (while (< i size)
    (printf "String at %p which is '%s'\n" (at array i) (at array i))
   (set i (+ i 1))))

(fn main i32 ((argc i32) (argv (ptr str)))
  (var str-arr (array (ptr i8) 5))
  (var i i32 0)
  (var arr-size i32 (- argc 1))
  (if (> arr-size 5)
    (progn
      (puts "More than 5 arguments passed, ignoring the rest\n")
      (set arr-size 5)))

  (while (< i arr-size)
    (set (at str-arr i) (deref (ptr+ argv (+ i 1))))
    (set i (+ i 1)))

  (puts "First, print array from main function\n")
  (set i 0)
  (while (< i arr-size)
    (printf "String at %p which is '%s'\n" (at str-arr i) (at str-arr i))
    (set i (+ i 1)))

  (puts "----------------------------------------\n")
  (puts "Now, pass array as an argument\n")
  (print-array str-arr arr-size)

  (puts "Now, int array!")
  (var fu (array u32 9))
  (set arr-size 9
       i 0)
  (set (at fu 0) 1
       (at fu 1) 2
       (at fu 2) 3
       (at fu 3) 4
       (at fu 4) 3
       (at fu 5) 2
       (at fu 6) 1
       (at fu 7) 0
       (at fu 8) 7)
  (while (< i arr-size)
    (printf "%d %d %d\n"
            (at fu i)
            (at fu (+ i 1))
            (at fu (+ i 2)))
    (set i (+ i 3)))

  (puts "Now, float array!")
  (var fa (array f32 9))
  (set arr-size 9
       i 0)
  (set (at fa 0) 1.2f32)
  (printf "(at fa 0) > 1.1? %d\n(at fa 0) < 1.3? %d\n" (> (at fa 0) 1.1f32) (< (at fa 0) 1.3f32))
  (while (< i arr-size)
    (printf "%f %f %f\n"
            (at fa i)
            (at fa (+ i 1))
            (at fa (+ i 2)))
    (set i (+ i 3)))

  (return 0))
