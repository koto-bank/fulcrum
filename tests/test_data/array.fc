(module array
  (import :c "stdio.h"))

(fn print-array void ((array (array (ptr i8) 10)) (size i32))
  (var i i32 0)
  (stdio.printf "Addr of passed array: %p\n" array)
  (while (< i size)
    (stdio.puts (nth array i))
    (set i (+ i 1))))

(fn main i32 ((argc i32) (argv (ptr (ptr i8))))
  (var str-arr (array (ptr i8) 10))
  (var i i32 0)
  (while (and (< i argc) (< i 10))
    (set (nth str-arr i) (deref (ptr+ argv i)))
    (set i (+ i 1)))

  (set i 0)
  (while (< i argc)
    (stdio.puts (nth str-arr i))
    (set i (+ i 1)))

  (stdio.printf "Addr of array: %p addr of 1st elt: %p\n" str-arr (nth str-arr 0))
  (stdio.puts "----------------")

  (print-array str-arr argc)

  (return 0))
