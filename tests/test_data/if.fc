(module if
  (import :c "stdio.h")
  (import :c "string.h"))

(fn main i32 ((argc i32) (argv (array str 10)))
  (var flag bool false)
  (var i u32 1u)
  (while (< i (cast argc u32))
    (puts "Current arg is")
    (puts (nth argv 0))
    (if (= 0 (strcmp "--true" (nth argv i)))
        (do (puts "--true flag passed")
            (return 0)))
    (set i (+ i 1u)))
  (puts "--true flag not passed")
  (return 1))
