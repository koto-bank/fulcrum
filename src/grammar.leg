%{
#include <stdio.h>
#include <stdlib.h>
#include <memory>

#include <csignal>

#include "parse_context.hpp"

#define YYSTYPE ParsedLine
#define YY_CTX_LOCAL 1
#define YY_CTX_MEMBERS \
    CodegenContext *code = nullptr; \
    std::unique_ptr<ParseContext> ctx;
%}

Program = - Module - (Statement -)* Eof

Statement = Struct | Var | Alias | Fn

Module = LP ('module' -) m:Id {
    yy->code->moduleName = m.str;
} Import* RP

Keyword = [:] < Char+ > - { $$.str = yytext; }

Import = LP 'import' {
    yy->ctx->import = std::make_unique<Import>();
} - (kw:Keyword {
    yy->ctx->import->keywords.push_back(kw.str);
})* (file:Str {
    yy->ctx->import->target = file.str;
} | name:Id {
    yy->ctx->import->target = name.str;
}) RP - {
    yy->code->imports.push_back(*yy->ctx->import.release());
}

Struct = LP StructType id:Id {
    assert(yy->ctx->structDef != nullptr);
    assert(yy->code->getType(id.str) == nullptr && "Structure already defined");
    yy->ctx->structDef->name = id.str;
} (StructField -)* - RP {
    assert(yy->ctx->structDef != nullptr);
    auto structDef = std::move(yy->ctx->structDef);
    yy->code->emplaceType<StructType>(structDef->name, structDef->name, std::move(structDef->fields), structDef->isPublic);
}

StructType = ('struct-' -) {
    assert(yy->ctx->structDef == nullptr && "Nested structure definitions are not allowed");
    yy->ctx->structDef = std::make_unique<ParseContext::StructDef>();
    yy->ctx->structDef->isPublic = false;
} | ('struct' -) {
    assert(yy->ctx->structDef == nullptr && "Nested structure definitions are not allowed");
    yy->ctx->structDef = std::make_unique<ParseContext::StructDef>();
    yy->ctx->structDef->isPublic = true;
}

StructField = LP id:Id - Type {
    assert(yy->ctx->structDef != nullptr);
    assert(yy->ctx->type != nullptr);
    yy->ctx->structDef->fields.emplace_back(id.str, yy->ctx->type.release());
} RP

Fn = ( LP FnType - id:Id {
    assert(yy->ctx->fnDef != nullptr);
    yy->ctx->fnDef->name = id.str;
} - Type {
    assert(yy->ctx->fnDef != nullptr);
    assert(yy->ctx->type != nullptr);
    yy->ctx->fnDef->returnType = yy->ctx->type.release();
} - ArgList # Hadled in its own clause
- (Expr {
    assert(yy->ctx->fnDef != nullptr);
    assert(yy->ctx->exprStack.size() == 1);
    auto& body = yy->ctx->fnDef->body;
    auto& exprs = yy->ctx->exprStack;
    body.push_back(std::move(yy->ctx->exprStack.back()));
    yy->ctx->exprStack.pop_back();
} -)* RP ) {
    assert(yy->ctx->fnDef != nullptr);
    auto fn = std::move(yy->ctx->fnDef);
    yy->code->emplaceFn(fn->name, fn->arguments,
                        fn->returnType,
                        std::move(fn->body),
                        fn->isPublic);
}

FnType = ('fn-' -) {
    assert(yy->ctx->fnDef == nullptr && "Nested function definitions are not allowed");
    yy->ctx->fnDef = std::make_unique<ParseContext::FunctionDef>();
    yy->ctx->fnDef->isPublic = false;
} | ('fn' -) {
    assert(yy->ctx->fnDef == nullptr && "Nested function definitions are not allowed");
    yy->ctx->fnDef = std::make_unique<ParseContext::FunctionDef>();
    yy->ctx->fnDef->isPublic = true;
}

ArgList = LP (ArgDecl -)* RP
ArgDecl = LP name:Id {
    assert(yy->ctx->fnDef != nullptr);
    yy->ctx->fnDef->arguments.emplace_back(name.str, nullptr);
} - Type RP {
    assert(yy->ctx->fnDef != nullptr);
    assert(!yy->ctx->fnDef->arguments.empty());
    assert(std::get<1>(yy->ctx->fnDef->arguments.back()) == nullptr);
    assert(yy->ctx->type != nullptr);
    std::get<1>(yy->ctx->fnDef->arguments.back()) = yy->ctx->type.release();
}

Type = PtrType | TypeName
PtrType = '*' - Type {
    assert(yy->ctx->type != nullptr);
    auto pointeeName = yy->ctx->type->signature();
    auto ptrName = pointeeName + "*";
    yy->ctx->type.reset(yy->code->getOrEmplaceType<PointerType>(ptrName, yy->ctx->type.release()));
}

TypeName = BuiltInType | CustomType
CustomType = id:Id {
    if (!yy->code->types.contains(id.str)) {
        yy->code->unresolvedCustomTypes.emplace(id.str, std::make_unique<CustomType>(yy->code->context, id.str));
    }
    assert(yy->ctx->type == nullptr);
    yy->ctx->type.reset(yy->code->getType(id.str));
}

BuiltInType = ( 'f32' {
    yy->ctx->type.reset(yy->code->getType("f32"));
    assert(yy->ctx->type != nullptr);
} | 'f64' {
    yy->ctx->type.reset(yy->code->getType("f64"));
    assert(yy->ctx->type != nullptr);
}) | 'void' {
    yy->ctx->type.reset(yy->code->getType("void"));
    assert(yy->ctx->type != nullptr);
} | 'bool' {
    yy->ctx->type.reset(yy->code->getType("bool"));
    assert(yy->ctx->type != nullptr);
} | IntegerType

IntegerType = ('i' {
    yy->ctx->isSigned = true;
} | 'u' {
    yy->ctx->isSigned = false;
}) < Bits > {
    auto isSigned = yy->ctx->isSigned;
    auto signature = std::string(isSigned ? "i" : "u") + yytext;
    yy->ctx->type.reset(yy->code->getOrEmplaceType<IntegerType>(signature, std::atoi(yytext), isSigned));
}
Bits = [1-9][0-9][0-9] | [1-9][0-9] | [1-9]
Var = LP 'var' Id Expr RP

Alias = LP 'alias' Id Id RP

Expr = FnCall | Literal | Dereference | AddrOfVar | IdExpr

FnCall = LP id:Id {
    yy->ctx->exprStack.push_back(std::make_unique<FunctionCall>(*yy->code, id.str));
} - (Expr {
    assert(!yy->ctx->exprStack.empty());
    auto expr = std::move(yy->ctx->exprStack.back());
    yy->ctx->exprStack.pop_back();

    assert(!yy->ctx->exprStack.empty());
    auto fnCall = dynamic_cast<FunctionCall*>(yy->ctx->exprStack.back().get());
    assert(fnCall != nullptr);
    fnCall->args.push_back(std::move(expr));
} -)* RP

# FieldAccess |
IdExpr = id:Id {
    yy->ctx->exprStack.push_back(std::make_unique<VarAccess>(id.str));
}

AddrOfVar = '&'- IdExpr {
    assert(!yy->ctx->exprStack.empty());
    auto expr = std::move(yy->ctx->exprStack.back());
    yy->ctx->exprStack.pop_back();

    yy->ctx->exprStack.push_back(std::make_unique<AddrOf>(*yy->code, std::move(expr)));
}

Dereference = ('@' {
    yy->ctx->exprStack.push_back(std::make_unique<Dereference>());
})+ - DereferencableExpr {
    assert(!yy->ctx->exprStack.empty());
    auto expr = std::move(yy->ctx->exprStack.back());
    yy->ctx->exprStack.pop_back();

    assert(!yy->ctx->exprStack.empty());
    auto deref = dynamic_cast<Dereference*>(yy->ctx->exprStack.back().get());
    assert(deref != nullptr);
    deref->target = std::move(expr);
}

DereferencableExpr = IdExpr | FnCall

Literal = s:Str {
    auto strType = yy->code->getOrEmplaceType<StringType>("str");
    yy->ctx->exprStack.push_back(std::make_unique<StringConstant>(strType, yy->code->module, s.str));
} | IntLiteral {
    auto isSigned = yy->ctx->intLiteral.isSigned;
    auto signature = std::string(isSigned ? "i" : "u");
    auto bits = yy->ctx->intLiteral.bits;
    yy->ctx->intLiteral.bits.clear();
    if (bits.empty()) {
        bits = "32";
    }
    signature += bits;
    auto intType = yy->code->getOrEmplaceType<IntegerType>(signature,
                                                           std::stoi(bits),
                                                           isSigned);
    isSigned
       ? yy->ctx->exprStack.push_back(std::make_unique<IntegerConstant>(intType, yy->ctx->intLiteral.num.i))
       : yy->ctx->exprStack.push_back(std::make_unique<IntegerConstant>(intType, yy->ctx->intLiteral.num.u))
       ;
} | f:FloatLiteral {
    std::cout << "Pushing new float literal to expr stack! "  << s.str << '\n';
//    auto strType = yy->code->getOrEmplaceType<StringType>("str");
//    yy->ctx->exprStack.push_back(std::make_unique<StringConstant>(strType, yy->code->module, s.str));
} | b:BoolLiteral {
    auto t = yy->code->getType("bool");
    assert(t != nullptr);
    yy->ctx->exprStack.push_back(std::make_unique<BoolConstant>(t, b.boolConst));
}

IntLiteral = < '-'? Num > {
    yy->ctx->intLiteral.str = yytext;
    yy->ctx->intLiteral.isSigned = true;
    yy->ctx->intLiteral.num.i = std::stoll(yy->ctx->intLiteral.str);
} (('i' | 'u' {
    yy->ctx->intLiteral.isSigned = false;
    yy->ctx->intLiteral.num.u = std::stoull(yy->ctx->intLiteral.str);
} ) ( < Bits > {
    yy->ctx->intLiteral.bits = yytext;
} )? )? -

FloatLiteral = < '-'? Num '.' Num > 'f'? - { $$.fNum = std::atof(yytext); }
BoolLiteral = 'false' { $$.boolConst = false; } | 'true' { $$.boolConst = true; }
Num = ('0' | [1-9] [0-9]* -)

LP = '(' -
RP = - ')'
Char = ( !Space . )
Str = ["] < ( !["] . )* > ["] - { $$.str = yytext; }

Id = ( < ( ![./] !LP !RP !Space Char )+ > &( Space | Comment | [.] | LP | RP )- { $$.str = yytext; }
   | < '/' > - ){ $$.str = yytext; } # division

- = ( Space | Comment )*
Space = ' ' | '\t' | Eol
Comment = ';' ( !Eol . )* Eol
Eol = '\r\n' | '\n' | '\r'
Eof = !.

%%

bool parse(CodegenContext *codegenCont) {
    printf("parsing started\n");

    yycontext yy;
    memset(&yy, 0, sizeof(yy));
    yy.code = codegenCont;
    yy.ctx = std::make_unique<ParseContext>();

    bool res = false;
    while(yyparse(&yy)) {
        res = true;
        printf("---- ---- ---- success! ---- ---- ---\n");
    }
    yy.ctx.release();

    yyrelease(&yy);
    return res;
}
