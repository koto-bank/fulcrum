%{
#include <stdio.h>
#include <stdlib.h>
#include <memory>

#include "parsing_types.hpp"

#define YYSTYPE ParsedLine
#define YY_CTX_LOCAL 1
#define YY_CTX_MEMBERS \
    CodegenContext *context = nullptr; \
    LanguageType *parsedType = nullptr; \
    LanguageType *currentlyDefiningType = nullptr; \
    FunctionParseContext functionBeingDefined; \
    FunctionCallParseContext functionCallBeingDefined; \
    std::unique_ptr<Expression> expressionBeingDefined; \
    \
    std::unique_ptr<Program> program; \
    bool isPublic, isSigned; \
%}

# How to compile: leg grammar.leg > parser.cpp && clang++ -std=c++20 parser.cpp -o parser
# Then echo test file to parser's stdin: cat tests/simple.fn | parser

Program = - Module - (Statement -)* Eof
Statement = Struct | Var | Alias | Fn
Module = LP ('module' -) m:Id {
    yy->program->module.name = m.str;
} Import* RP

Keyword = [:] < Char+ > - { $$.str = yytext; }

Import = LP ('import' -) {
    yy->program->module.imports.emplace_back();
} (kw:Keyword {
    yy->program->module.imports.back().keywords.push_back(kw.str);
})* (file:Str {
    yy->program->module.imports.back().filename = file.str;
} | name:Id {
    yy->program->module.imports.back().module = name.str;
}) RP -

Struct = LP StructType Id {
    if (yy->context->types.contains(yytext)) {
      // TODO: Error, struct already defined
      printf("Struct %s redefined", yytext);
      return;
    }

    yy->context->types.emplace(yytext, std::make_unique<StructType>(yy->context->context, yytext, decltype(StructType::fields){}, yy->isPublic));
    assert(yy->currentlyDefiningType == nullptr);
    yy->currentlyDefiningType = yy->context->types.at(yytext).get();
} (StructField -)* - RP {
    assert(yy->currentlyDefiningType != nullptr);
    yy->currentlyDefiningType = nullptr;
}

StructType = ('struct-' -) {
    yy->isPublic = false;
} | ('struct' -) {
    yy->isPublic = true;
}

StructField = LP id:Id - Type {
    auto structTp = (StructType *)yy->currentlyDefiningType;
    assert(yy->parsedType != nullptr);
    structTp->fields.emplace_back(id.str, yy->parsedType);
    yy->parsedType = nullptr;
} RP

Fn = ( LP FnType - id:Id {
    yy->functionBeingDefined.arguments.clear();
    yy->functionBeingDefined.name = id.str;
    yy->functionBeingDefined.returnType = nullptr;
} - Type {
    assert(yy->functionBeingDefined.returnType == nullptr);
    yy->functionBeingDefined.returnType = yy->parsedType;
    yy->parsedType = nullptr;
} - ArgList - (Expr {
    auto &fn = yy->functionBeingDefined;
    assert(yy->expressionBeingDefined != nullptr);
    std::cout << "Adding new expr to fn body!\n";
    fn.body.push_back(std::move(yy->expressionBeingDefined));
} -)* RP ) {
    auto &fn = yy->functionBeingDefined;
    const auto &name = fn.name;
    yy->context->functions.emplace(name, Function(yy->context->context,
                                                  yy->context->module,
                                                  name,
                                                  fn.arguments,
                                                  fn.returnType,
                                                  std::move(fn.body),
                                                  yy->isPublic));
}

FnType = ('fn-' -) {
    yy->isPublic = false;
} | ('fn' -) {
    yy->isPublic = true;
}

ArgList = LP (ArgDecl -)* RP
ArgDecl = LP name:Id - Type RP {
   yy->functionBeingDefined.arguments.emplace_back(name.str, yy->parsedType);
}

Type = PtrType | TypeName
PtrType = '*' - Type {
    auto pointeeName = yy->parsedType->signature();
    auto ptrName = pointeeName + "*";
    // If such a pointer type already exists, use it. Otherwise add it
    if (!yy->context->types.contains(ptrName)) {
        yy->context->types.emplace(ptrName, std::make_unique<PointerType>(yy->context->context, yy->parsedType));
    }
    yy->parsedType = yy->context->types.at(ptrName).get();
}

TypeName = BuiltInType | CustomType
CustomType = n:Id {
    if (!yy->context->types.contains(n.str)) {
        yy->context->unresolvedCustomTypes.emplace(yytext, std::make_unique<CustomType>(yy->context->context, yytext));
    }
    assert(yy->parsedType == nullptr);
    yy->parsedType = yy->context->types.at(yytext).get();
}

BuiltInType = ( 'f32' {
    yy->parsedType = yy->context->types.at("f32").get();
} | 'f64' {
    yy->parsedType = yy->context->types.at("f64").get();
}) | 'void' {
    yy->parsedType = yy->context->types.at("void").get()
} | 'bool' {
    yy->parsedType = yy->context->types.at("bool").get()
} | IntegerType

IntegerType = ('i' {
    yy->isSigned = true;
} | 'u' {
    yy->isSigned = false;
}) < Bits > {
    bool isSigned = yy->isSigned;
    std::string signature = std::string(isSigned ? "i" : "u") + yytext;
    if (!yy->context->types.contains(signature)) {
       yy->context->types.emplace(signature, std::make_unique<IntegerType>(yy->context->context, std::atoi(yytext), isSigned));
    }
    yy->parsedType = yy->context->types.at(signature).get();
}
Bits = [1-9][0-9][0-9] | [1-9][0-9] | [1-9]
Var = LP 'var' Id Expr RP

Alias = LP 'alias' Id Id RP

Expr = FnCall | IdExpr | Literal | FieldAccess

FnCall = LP id:Id {
    yy->functionCallBeingDefined.name = id.str;
} - (Expr {
    yy->functionCallBeingDefined.args.push_back(std::move(yy->expressionBeingDefined));
} -)* RP {
    auto& fnDef = yy->functionCallBeingDefined;
    auto fnCall = std::make_unique<FunctionCall>(*yy->context, fnDef.name, std::move(fnDef.args));
    yy->expressionBeingDefined = std::move(fnCall);
}

IdExpr = Id | AddrOfVar
AddrOfVar = '&' - IdExpr

Literal = c:Str {
    if (!yy->context->types.contains("str")) {
        yy->context->types.emplace("str", std::make_unique<StringType>(yy->context->context));
    }
    yy->expressionBeingDefined = std::make_unique<StringConstant>(yy->context->module,
                                                                  yy->context->types.at("str").get(),
                                                                  c.str);
} | i:IntLiteral {
} | f:FloatLiteral {
} | b:BoolLiteral {
    auto t = yy->context->types.at("bool").get();
    assert(t != nullptr);
    yy->expressionBeingDefined = std::make_unique<BoolConstant>(t, $$.boolConst);
}

IntLiteral = < '-'? ( Num | Num > [iu] Bits? ) - { $$.iNum = std::atoi(yytext); }
FloatLiteral = < '-'? Num '.' Num > 'f'? - { $$.fNum = std::atof(yytext); }
BoolLiteral = 'false' { $$.boolConst = false; } | 'true' { $$.boolConst = true; }
Num = ('0' | [1-9] [0-9]* -)

FieldAccess = FieldTarget Id
FieldTarget = Id - '.'

LP = '(' -
RP = - ')'
Char = ( !Space . )
Str = ["] < ( !["] Char )* > ["] - { $$.str = yytext; }
Id = < ( ![.] !LP !RP Char )+ > - { $$.str = yytext; }

- = ( Space | Comment )*
Space = ' ' | '\t' | Eol
Comment = ';' ( !Eol . )* Eol
Eol = '\r\n' | '\n' | '\r'
Eof = !.

%%

std::unique_ptr<Program> parse(CodegenContext *codegenCont) {
    printf("Parsing started\n");

    yycontext yy;
    memset(&yy, 0, sizeof(yy));
    yy.program = std::make_unique<Program>();
    yy.context = codegenCont;

    while(yyparse(&yy)) {
        printf("---- ---- ---- success! ---- ---- ---\n");
    }
    printf("Parsing finished\n");
    auto program = std::move(yy.program);
    yyrelease(&yy);
    program->print();
    return std::move(program);
}
