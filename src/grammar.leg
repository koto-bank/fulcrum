%{
#include <stdio.h>
#include <stdlib.h>
#include <memory>

#include <csignal>

#include <fmt/format.h>
#include "parse_context.hpp"

#define YYSTYPE ParsedLine
#define YY_CTX_LOCAL 1
#define YY_CTX_MEMBERS \
    CodegenContext *code = nullptr; \
    std::unique_ptr<ParseContext> ctx;
%}

Program = - Module - (Statement -)* Eof

Statement = Struct | Alias | Fn

Module = LP ('module' -) m:Id {
    yy->ctx->module = std::make_unique<ModuleNode>(m.str);
} Import* RP

Keyword = [:] < Char+ > - { $$.str = yytext; }

Import = LP 'import' {
    yy->ctx->import = std::make_unique<ModuleNode::Import>();
} - (kw:Keyword {
    yy->ctx->import->keywords.push_back(kw.str);
})* (file:Str {
    yy->ctx->import->target = file.str;
} | name:Id {
    yy->ctx->import->target = name.str;
}) RP - {
    yy->ctx->module->imports.push_back(*yy->ctx->import.release());
}

Struct = LP StructType id:Id {
    assert(yy->ctx->structDef != nullptr);
    assert(yy->code->getType(id.str) == nullptr && "Structure already defined");
    yy->ctx->structDef->name = id.str;
} (StructField -)* - RP {
    assert(yy->ctx->structDef != nullptr);
    assert(yy->ctx->module != nullptr);

    yy->ctx->module->structs.push_back(std::move(yy->ctx->structDef));
}

StructType = ('struct-' -) {
    assert(yy->ctx->structDef == nullptr && "Nested structure definitions are not allowed");
    yy->ctx->structDef = std::make_unique<StructNode>();
    yy->ctx->structDef->isPublic = false;
} | ('struct' -) {
    assert(yy->ctx->structDef == nullptr && "Nested structure definitions are not allowed");
    yy->ctx->structDef = std::make_unique<StructNode>();
    yy->ctx->structDef->isPublic = true;
}

StructField = LP id:Id - Type {
    assert(yy->ctx->structDef != nullptr);
    assert(yy->ctx->type != nullptr);
    yy->ctx->structDef->fields.emplace_back(id.str, std::move(yy->ctx->type));
} RP

Fn = (LP FnType - id:Id {
    assert(yy->ctx->fnDef != nullptr);
    yy->ctx->fnDef->name = id.str;
} - Type {
    assert(yy->ctx->fnDef != nullptr);
    assert(yy->ctx->type != nullptr);
    yy->ctx->fnDef->returnType = std::move(yy->ctx->type);
} - ArgList # Hadled in its own clause
- (Expr {
    assert(yy->ctx->fnDef != nullptr);
    auto& body = yy->ctx->fnDef->body;
    auto& exprs = yy->ctx->exprStack;
    body.insert(body.end(),
                std::make_move_iterator(exprs.begin()),
                std::make_move_iterator(exprs.end()));
    exprs.clear();
} -)* RP) {
    assert(yy->ctx->fnDef != nullptr);
    assert(yy->ctx->module != nullptr);

    auto fn = std::move(yy->ctx->fnDef);
    yy->ctx->module->functions.emplace_back(std::move(fn));
}

FnType = ('fn-' -) {
    assert(yy->ctx->fnDef == nullptr && "Nested function definitions are not allowed");
    yy->ctx->fnDef = std::make_unique<FunctionNode>();
    yy->ctx->fnDef->isPublic = false;
} | ('fn' -) {
    assert(yy->ctx->fnDef == nullptr && "Nested function definitions are not allowed");
    yy->ctx->fnDef = std::make_unique<FunctionNode>();
    yy->ctx->fnDef->isPublic = true;
}

ArgList = LP (ArgDecl -)* RP
ArgDecl = LP name:Id {
    assert(yy->ctx->fnDef != nullptr);
    yy->ctx->fnDef->arguments.emplace_back(name.str, nullptr);
} - Type {
    assert(yy->ctx->fnDef != nullptr);
    assert(!yy->ctx->fnDef->arguments.empty());
    assert(std::get<1>(yy->ctx->fnDef->arguments.back()) == nullptr);
    assert(yy->ctx->type != nullptr);
    std::get<1>(yy->ctx->fnDef->arguments.back()) = std::move(yy->ctx->type);
} RP

Type = ArrType | PtrType | TypeName

ArrType = LP 'array' Space+ < Num > {
    yy->ctx->arraySize = std::atoll(yytext);
} - Type RP {
    assert(yy->ctx->type != nullptr);
    auto size = yy->ctx->arraySize;
    yy->ctx->type = std::make_unique<ASTArrayType>(std::move(yy->ctx->type), size);
}

PtrType = '*' - Type {
    assert(yy->ctx->type != nullptr);

    yy->ctx->type = std::make_unique<ASTPointerType>(std::move(yy->ctx->type));
}

TypeName = BuiltInType | CustomType
CustomType = id:Id {
    assert(yy->ctx->type == nullptr);

    yy->ctx->type = std::make_unique<ASTNamedType>(id.str);
}

BuiltInType = ( 'f32' {
    yy->ctx->type = std::make_unique<ASTBuiltinType>("f32");
} | 'f64' {
    yy->ctx->type = std::make_unique<ASTBuiltinType>("f64");
}) | 'void' {
    yy->ctx->type = std::make_unique<ASTBuiltinType>("void");
} | 'bool' {
    yy->ctx->type = std::make_unique<ASTBuiltinType>("bool");
} | IntegerType

IntegerType = ('i' {
    yy->ctx->isSigned = true;
} | 'u' {
    yy->ctx->isSigned = false;
}) < Bits > {
    auto isSigned = yy->ctx->isSigned;
    auto signature = std::string(isSigned ? "i" : "u") + yytext;

    // The type may already exist
    yy->code->ensureType<IntegerType>(signature, std::atoi(yytext), isSigned);
    yy->ctx->type = std::make_unique<ASTBuiltinType>(signature);
}
Bits = [1-9][0-9][0-9] | [1-9][0-9] | [1-9]

Alias = LP 'alias' Space+ Id - Id RP

Expr = Literal | Dereference | AddrOfVar | IdExpr | VarDeclaration | Sizeof | FnCall

VarDeclaration = LP 'var' - VarList RP
VarList = (VarDecl -)+
VarDecl = LP name:Id {
    yy->ctx->exprStack.push_back(std::make_unique<VariableDeclarationNode>(name.str));
} - Type {
    assert(!yy->ctx->exprStack.empty());
    auto varDecl = dynamic_cast<VariableDeclarationNode *>(yy->ctx->exprStack.back().get());
    assert(varDecl != nullptr);
    assert(yy->ctx->type != nullptr);
    varDecl->type = std::move(yy->ctx->type);
} - (Expr {
    assert(!yy->ctx->exprStack.empty());
    auto expr = std::move(yy->ctx->exprStack.back());
    yy->ctx->exprStack.pop_back();
    assert(!yy->ctx->exprStack.empty());
    auto varDecl = dynamic_cast<VariableDeclarationNode *>(yy->ctx->exprStack.back().get());
    assert(varDecl != nullptr);
    varDecl->initialValue = std::move(expr);
})? RP

Sizeof = LP 'sizeof' Space+ - Type RP {
    assert(yy->ctx->type != nullptr);
    yy->ctx->exprStack.push_back(std::make_unique<SizeofNode>(std::move(yy->ctx->type)));
}

FnCall = LP id:Id {
    yy->ctx->exprStack.push_back(std::make_unique<FunctionCallNode>(id.str));
} - (Expr {
    assert(!yy->ctx->exprStack.empty());
    auto expr = std::move(yy->ctx->exprStack.back());
    yy->ctx->exprStack.pop_back();

    assert(!yy->ctx->exprStack.empty());
    auto fnCall = dynamic_cast<FunctionCallNode *>(yy->ctx->exprStack.back().get());
    assert(fnCall != nullptr);
    fnCall->args.push_back(std::move(expr));
} -)* RP

IdExpr = id:Id {
    yy->ctx->exprStack.push_back(std::make_unique<VarAccessNode>(id.str));
}

AddrOfVar = '&'- IdExpr {
    assert(!yy->ctx->exprStack.empty());
    auto expr = std::move(yy->ctx->exprStack.back());
    yy->ctx->exprStack.pop_back();

    yy->ctx->exprStack.push_back(std::make_unique<AddrOfNode>(std::move(expr)));
}

Dereference = ('@' {
    yy->ctx->exprStack.push_back(std::make_unique<DereferenceNode>());
})+ - DereferencableExpr {
    assert(!yy->ctx->exprStack.empty());
    auto expr = std::move(yy->ctx->exprStack.back());
    yy->ctx->exprStack.pop_back();

    assert(!yy->ctx->exprStack.empty());
    auto deref = dynamic_cast<DereferenceNode*>(yy->ctx->exprStack.back().get());
    assert(deref != nullptr);
    deref->target = std::move(expr);
}

DereferencableExpr = IdExpr | FnCall

Literal = s:Str {
    yy->code->ensureType<StringType>("str");
    yy->ctx->exprStack.push_back(std::make_unique<ConstantStringNode>(s.str));
} | IntLiteral {
    auto isSigned = yy->ctx->intLiteral.isSigned;
    auto signature = std::string(isSigned ? "i" : "u");
    auto bits = yy->ctx->intLiteral.bits;
    yy->ctx->intLiteral.bits.clear();
    if (bits.empty()) {
        bits = "32";
    }
    signature += bits;

    // Make sure the type exists for the future
    yy->code->ensureType<IntegerType>(signature, std::stoi(bits), isSigned);
    isSigned
       ? yy->ctx->exprStack.push_back(std::make_unique<ConstantIntNode>(ASTBuiltinType(signature), yy->ctx->intLiteral.num.i))
       : yy->ctx->exprStack.push_back(std::make_unique<ConstantIntNode>(ASTBuiltinType(signature), yy->ctx->intLiteral.num.u))
       ;
} | f:FloatLiteral {
    std::cout << "Pushing new float literal to expr stack! "  << s.str << '\n';
//    auto strType = yy->code->getOrEmplaceType<StringType>("str");
//    yy->ctx->exprStack.push_back(std::make_unique<StringConstant>(strType, yy->code->module, s.str));
} | b:BoolLiteral {
    yy->ctx->exprStack.push_back(
        std::make_unique<ConstantBoolNode>(b.boolConst)
    );
}

IntLiteral = < '-'? Num > {
    yy->ctx->intLiteral.str = yytext;
    yy->ctx->intLiteral.isSigned = true;
    yy->ctx->intLiteral.num.i = std::stoll(yy->ctx->intLiteral.str);
} (('i' | 'u' {
    yy->ctx->intLiteral.isSigned = false;
    yy->ctx->intLiteral.num.u = std::stoull(yy->ctx->intLiteral.str);
} ) ( < Bits > {
    yy->ctx->intLiteral.bits = yytext;
} )? )? -

FloatLiteral = < '-'? Num '.' Num > 'f'? - { $$.fNum = std::atof(yytext); }
BoolLiteral = 'false' { $$.boolConst = false; } | 'true' { $$.boolConst = true; }
Num = ('0' | [1-9] [0-9]* -)

LP = '(' -
RP = - ')'
Char = ( !Space . )
Str = ["] < ( !["] . )* > ["] - { $$.str = yytext; }

Id = ( < ( ![./] !LP !RP !Space Char )+ > &( Space | Comment | [.] | LP | RP )- { $$.str = yytext; }
   | < '/' > - ){ $$.str = yytext; } # division

- = ( Space | Comment )*
Space = ' ' | '\t' | Eol
Comment = ';' ( !Eol . )* Eol
Eol = '\r\n' | '\n' | '\r'
Eof = !.

%%

std::unique_ptr<ModuleNode> parse(CodegenContext *codegenCont) {
    std::cout << "parsing started\n";

    yycontext yy;
    memset(&yy, 0, sizeof(yy));
    yy.code = codegenCont;
    yy.ctx = std::make_unique<ParseContext>();

    bool res = false;
    while(yyparse(&yy)) {
        res = true;
        std::cout << "---- ---- ---- success! ---- ---- ---\n";
    }

    std::unique_ptr<ModuleNode> moduleAST;
    if (res) {
       moduleAST = std::move(yy.ctx->module);
    }
    yy.ctx.release();
    yyrelease(&yy);

    return moduleAST;
}
